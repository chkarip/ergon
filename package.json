{
  "name": "ergon",
  "version": "1.0.0",
  "description": "A desktop application to manage and run development projects",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "icon": "node scripts/generate-icon.js"
  },
  "keywords": [
    "electron",
    "ergon",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "electron-packager": "^17.1.2"
  },
  "build": {
    "appId": "com.ergon.app",
    "productName": "Ergon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!app-*.js"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.png",
      "sign": null
    }
  }
}
